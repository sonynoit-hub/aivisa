{
  "name": "aivisa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "./scripts/run-standalone.sh",
  "lint": "eslint --cache --cache-location .eslintcache --ext .ts,.tsx src",
    "tsc": "tsc --noEmit",
    "clean": "rm -rf .next node_modules/.cache .eslintcache tsconfig.tsbuildinfo || true",
    "docker:build": "docker build -t aivisa-web:latest .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file ./.env.production.local aivisa-web:latest",
    "env:init": "node ./scripts/setup-env.mjs"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.31.6",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.542.0",
    "next": "15.5.2",
    "next-intl": "^4.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^4.12.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.12",
    "typescript": "^5"
  }
}
